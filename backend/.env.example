# BLOCKS API: environment. Copy to `.env` for local use. Never commit `.env`.
#
# Outside production, anything marked "dev default" can be left out and a clearly
# labelled development value is used (the API prints a warning saying so).
# In production the API REFUSES TO START if a required value is missing or weak.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Reverse proxies in front of the API (load balancer, CDN). Needed for real client IPs.
TRUST_PROXY_HOPS=0
# Browser origins allowed to call the API (the admin console). Comma-separated.
# Required in production; a wildcard is rejected. Mobile apps send no Origin and are unaffected.
CORS_ORIGINS=http://localhost:3000
# /api/docs. Defaults to on outside production, off in production.
# SWAGGER_ENABLED=true

# --- database and cache --------------------------------------------------------
# `npm run db:up` prints a ready-made URL for a local PostgreSQL.
DATABASE_URL=postgresql://blocks:blocks_dev@127.0.0.1:54340/blocks_dev
# Connections per API instance: size as (database limit / instances), or use PgBouncer.
DATABASE_POOL_MAX=10
# Shared rate-limit and sign-in counters. Required in production; optional locally
# (without it, counters live in each process and the API says so).
# REDIS_URL=redis://127.0.0.1:6379/0

# --- secrets (32+ characters; generate with: openssl rand -base64 48) ------------
# JWT_SECRET=
# While rotating: put the old value here; it verifies tokens but never signs them.
# JWT_SECRET_PREVIOUS=
# OTP_HMAC_SECRET=
# BLIND_INDEX_KEY=
# Field encryption for KYC, bank and tax details. JSON of key id -> base64 of 32 random bytes.
#   FIELD_ENCRYPTION_KEYS={"k1":"<base64 of 32 bytes>"}
#   FIELD_ENCRYPTION_ACTIVE_KEY=k1
# To rotate: add k2, make it active; old values still decrypt with k1 and are re-encrypted lazily.
# FIELD_ENCRYPTION_KEYS=
# FIELD_ENCRYPTION_ACTIVE_KEY=

# --- sessions and sign-in --------------------------------------------------------
JWT_ISSUER=blocks-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
ADMIN_ACCESS_TOKEN_TTL_SECONDS=600
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_MAX_HOURS=8
ADMIN_INVITE_TTL_HOURS=72
# Where staff sign in (put in invitation e-mails).
ADMIN_CONSOLE_URL=http://localhost:3000
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
ACCOUNT_DELETION_GRACE_DAYS=30

# --- providers: dev writes to an in-memory outbox; production needs real ones ----
EMAIL_PROVIDER=dev
EMAIL_FROM="BLOCKS <no-reply@blocks.example>"
# SMTP_URL=
SMS_PROVIDER=dev
PUSH_PROVIDER=dev
# KYC, bank verification and payouts only have a clearly-labelled mock today.
KYC_PROVIDER=mock
BANK_VERIFICATION_PROVIDER=mock
PAYOUT_PROVIDER=mock
# Who takes an advertiser's money. "none" means nobody: campaigns can be approved but never paid for,
# so none ever runs. "dev" pays for them without moving money (development and tests; refused in production).
ADS_BILLING_PROVIDER=none
# Lets a developer read "sent" codes at GET /api/v1/dev/outbox (local network only).
# Refused in production.
DEV_OUTBOX_ENABLED=true
# Housekeeping timers (retry deliveries, purge codes, erase accounts) in this process.
# Off under test; on otherwise.
# WORKERS_ENABLED=true

# --- object storage ---------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# S3-compatible (AWS S3, Cloudflare R2, MinIO...). Required when STORAGE_DRIVER=s3.
# S3_REGION=
# S3_ENDPOINT=
# S3_BUCKET_PRIVATE=
# S3_BUCKET_KYC=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CDN_BASE_URL=
UPLOAD_URL_TTL_SECONDS=900
# This API's public address. Signed media links are built from it when there is no CDN.
PUBLIC_API_URL=http://localhost:4000
# Where shared links to posts, reels and profiles open (the web app or a smart link).
PUBLIC_WEB_URL=https://blocks.example

# --- media processing -------------------------------------------------------------
# The programs that check, re-encode and assemble uploads. Production must use the host's own
# patched, supported builds (the dev-only npm packages are old and must never be shipped).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# How many files one process works on at once (1-8), and where it keeps scratch files.
MEDIA_WORKER_CONCURRENCY=2
# MEDIA_TEMP_DIR=
# Who decides whether an upload may be shown:
#   dev     approves everything (development only; production refuses to start with it)
#   manual  every upload waits for a person in the moderation queue (safe, slow)
# Connect an automated service by adding a provider; nothing else changes.
MODERATION_PROVIDER=dev

# --- seed / first admin (development only) -----------------------------------------
# `npm run db:seed` creates one super admin if there is none, with a random password
# printed once. In production create the first one with `npm run admin:create`.
# SEED_ADMIN_EMAIL=admin@blocks.local
# SEED_ADMIN_NAME=Local Administrator

# --- identity, bank accounts and payouts ------------------------------------------
# Master switch. On in development; OFF by default in production, and production refuses to
# start with it on while only the mock providers below exist (no real identity document or
# real money should pass through a stand-in).
# MONEY_FEATURES_ENABLED=true
# Defaults for limits (min / max / daily payout, KYC validity, document retention) live in
# system settings (payouts.* and kyc.*), not here: staff change them without a deploy.
