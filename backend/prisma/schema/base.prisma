// BLOCKS database schema, split by domain across prisma/schema/*.prisma.
//
// Conventions
//   * Tables are snake_case plurals (@@map), columns snake_case (@map).
//   * Primary keys are UUID v7 generated by the client library, so they sort by
//     creation time and need no particular PostgreSQL version.
//   * Money is NUMERIC(18,2) rupees. Never a float.
//   * Timestamps are timestamptz(3).
//   * Constraints Prisma cannot express (CHECKs, partial indexes, trigram
//     indexes, append-only triggers, the ledger) live in hand-written SQL
//     migrations next to the generated one.
//   * Fields marked ENCRYPTED hold AES-256-GCM ciphertext written by the
//     application (see docs/security.md). Fields marked BLIND INDEX hold an
//     HMAC used only to detect duplicates.

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}
