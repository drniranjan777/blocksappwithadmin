# BLOCKS — NON-SECRET build configuration.
#
# Values are passed at build time with --dart-define (never bundled as secrets):
#
#   Demo (no server needed, the default):
#     flutter run --dart-define=APP_ENV=demo
#
#   Against a local development API (backend: `npm run db:up`, then `npx nest start`):
#     flutter run \
#       --dart-define=APP_ENV=staging \
#       --dart-define=DEMO_MODE=false \
#       --dart-define=API_BASE_URL=http://10.0.2.2:4000       # Android emulator
#       --dart-define=API_BASE_URL=http://localhost:4000      # iOS simulator, desktop, web
#
#   Or put the same values in a file kept out of source control:
#     flutter run --dart-define-from-file=env/staging.json
#
# NEVER put API keys, tokens, passwords or payment credentials in this file
# or in any file that is committed. Real secrets belong in a secrets manager
# on the server; the app only ever receives short-lived tokens, which it keeps in
# the Keychain / Keystore.

APP_ENV=demo                 # demo | staging | production
DEMO_MODE=true               # true = use Mock*Repository implementations; false = the real API
ENABLE_LOGGING=true          # one redacted line per request (route and status only), debug builds only

# The server's address WITHOUT a path: the app adds /api/v1.
#  - required when DEMO_MODE=false; the app refuses to start without a valid one
#  - must be https, except http://localhost, http://127.0.0.1 or http://10.0.2.2
#    (the Android emulator's name for your computer), and never in production
#  - no user name, query string or fragment
API_BASE_URL=                # e.g. https://api.staging.example.com

# With a development API, signed media addresses are built from the API's own
# PUBLIC_API_URL. An Android emulator cannot reach "localhost", so start the API with
# PUBLIC_API_URL=http://10.0.2.2:4000 when testing uploads there.
